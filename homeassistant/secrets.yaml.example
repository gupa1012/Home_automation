######################################################################
# secrets.yaml.example
# Kopiere diese Datei nach secrets.yaml und trage deine Werte ein.
# secrets.yaml wird NICHT ins Repository eingecheckt (.gitignore).
######################################################################

# Standort
home_latitude: "48.1351"
home_longitude: "11.5820"
home_elevation: "519"

# URLs
external_url: "https://dein-name.duckdns.org"
internal_url: "http://192.168.1.10:8123"

# MQTT
mqtt_username: "ha_mqtt"
mqtt_password: "sicheres-passwort-hier"

# Reolink Türklingel
reolink_doorbell_host: "192.168.1.50"
reolink_doorbell_username: "admin"
reolink_doorbell_password: "reolink-passwort"

# Reolink Kamera 1 (Einfahrt)
reolink_cam1_host: "192.168.1.51"
reolink_cam1_username: "admin"
reolink_cam1_password: "reolink-passwort"

# Reolink Kamera 2 (Garten)
reolink_cam2_host: "192.168.1.52"
reolink_cam2_username: "admin"
reolink_cam2_password: "reolink-passwort"

# SMA Wechselrichter
sma_host: "192.168.1.60"
sma_password: "sma-passwort"

# Android Tablet (Fully Kiosk Browser)
tablet_ip: "192.168.1.100"
fkb_password: "kiosk-passwort"

# Mobile Benachrichtigungen (HA Companion App Gerätenamen)
notify_person1_device: "mobile_app_telefon_person1"
notify_person2_device: "mobile_app_telefon_person2"
